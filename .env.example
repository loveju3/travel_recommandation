# ── 資料庫 ─────────────────────────────
# Neon Dashboard → Connect → 關閉 Connection pooling → 複製連線字串（結尾要有 ?sslmode=require）
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── OpenAI ─────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxx

# Embedding 設定（改模型或維度後要重跑 scripts/ingest.py）
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# 對話模型：query 解析、推薦理由
CHAT_MODEL=gpt-4o-mini

# 設成 1 會整體關閉 LLM（搜尋仍可運作）
DISABLE_LLM=0
